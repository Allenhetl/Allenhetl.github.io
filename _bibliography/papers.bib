@inproceedings{he2026vista,
  abbr        = {ICML},
  bibtex_show = {true},
  title       = {MVISTA-4D: View-Consistent 4D World Model with Test-Time Action Inference for Robotic Manipulation},
  author      = {Wang, Jiaxu and Jiang, Yicheng and He, Tianlun and Sun, Jingkai and Zhang, Qiang and He, Junhao and Cao, Jiahang and Gan, Zesen and Sun, Mingyuan and Shao, Qiming and Yue, Xiangyu},
  booktitle   = {Proceedings of the 43rd International Conference on Machine Learning (ICML)},
  year        = {2026},
  month       = {Apr},
  selected    = {true},
  abstract    = {We propose an embodied 4D world model for robotic manipulation that takes single-view RGBD input and generates multi-view-consistent 3D/4D scene representations, enabling an "imagine-then-act" decision paradigm. The work covers a complete loop from sensor capture, multi-view reconstruction, dataset construction, and model training, to real-robot validation, demonstrating the feasibility of generative world models for action reasoning on physical robots.},
  arxiv       = {2602.09878},
  website     = {https://mercerai.github.io/MVISTA-4D/},
}

@article{wang2026echo,
  abbr        = {arXiv},
  bibtex_show = {true},
  title       = {ECHO: Event-Augmented Context with Hindsight and Outlook for Wrist-Only Manipulation},
  author      = {Wang, Xinyue and Jiang, Yicheng and Gan, Zesen and He, Junhao and Wang, Jiaxu and Li, Junhao and Zhang, Jingtao and He, Tianlun and Wang, Jianan and Guan, Isabel and Shao, Qiming},
  journal     = {arXiv preprint arXiv:2609.34893},
  year        = {2026},
  month       = {Sep},
  selected    = {true},
  abstract    = {ECHO is a wrist-only latent world action model that encodes wrist-mounted event-camera streams into compact motion representations, combining current event features, an addressable off-camera trajectory memory (hindsight), and learnable event foresight queries (outlook). It improves manipulation robustness under extreme exposure, outperforming RGB and RGB+event baselines on wrist-only RLBench tasks and in real-robot experiments under dark lighting.},
  arxiv       = {2609.34893},
  website     = {https://echo-wam.github.io/},
}
