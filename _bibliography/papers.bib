@inproceedings{he2026vista,
  abbr        = {ICML},
  bibtex_show = {true},
  title       = {Embodied 4D World Model for Robotic Manipulation},
  author      = {He, Tianlun and others},
  booktitle   = {Proceedings of the 43rd International Conference on Machine Learning (ICML)},
  year        = {2026},
  month       = {Apr},
  selected    = {true},
  abstract    = {We propose an embodied 4D world model for robotic manipulation that takes single-view RGBD input and generates multi-view-consistent 3D/4D scene representations, enabling an "imagine-then-act" decision paradigm. The work covers a complete loop from sensor capture, multi-view reconstruction, dataset construction, and model training, to real-robot validation, demonstrating the feasibility of generative world models for action reasoning on physical robots.},
