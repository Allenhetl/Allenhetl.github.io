---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign category_en = page.category | capitalize %}
{% assign category_zh = page.category %}
{% case page.category %}
  {% when 'research' %}
    {% assign category_en = 'Research' %}
    {% assign category_zh = '研究' %}
  {% when 'robomaster' %}
    {% assign category_en = 'RoboMaster' %}
    {% assign category_zh = 'RoboMaster' %}
  {% when 'year-project' %}
    {% assign category_en = 'Year Project' %}
    {% assign category_zh = '学年项目' %}
  {% when 'coursework' %}
    {% assign category_en = 'Coursework' %}
    {% assign category_zh = '课设' %}
{% endcase %}

{% assign status_en = '' %}
{% assign status_zh = '' %}
{% case page.project_status %}
  {% when 'completed' %}
    {% assign status_en = 'Completed' %}
    {% assign status_zh = '已完成' %}
  {% when 'accepted' %}
    {% assign status_en = 'Accepted' %}
    {% assign status_zh = '已接收' %}
  {% when 'ongoing' %}
    {% assign status_en = 'Ongoing' %}
    {% assign status_zh = '进行中' %}
  {% when 'tenure-completed' %}
    {% assign status_en = 'Tenure completed' %}
    {% assign status_zh = '任期结束' %}
{% endcase %}

{% assign hero_path = page.hero_img | default: page.img %}
{% assign hero_fit = page.hero_fit | default: page.card_fit | default: 'cover' %}
{% assign hero_pos = page.hero_pos | default: page.card_pos | default: 'center center' %}
{% assign hero_alt = page.hero_alt | default: page.card_alt %}
{% if hero_alt == blank %}
  {% assign hero_alt = page.title | regex_replace: '<span class="lang-zh-only">.*?</span>', '' | strip_html | strip %}
{% endif %}
{% assign hero_width_class = '' %}
{% assign hero_sizes = '(min-width: 960px) 930px, calc(100vw - 30px)' %}
{% case page.hero_width %}
  {% when 'compact' %}
    {% assign hero_width_class = ' project-case__hero--compact' %}
    {% assign hero_sizes = '(min-width: 768px) 672px, calc(100vw - 30px)' %}
  {% when 'medium' %}
    {% assign hero_width_class = ' project-case__hero--medium' %}
    {% assign hero_sizes = '(min-width: 768px) 544px, calc(100vw - 30px)' %}
  {% when 'narrow' %}
    {% assign hero_width_class = ' project-case__hero--narrow' %}
    {% assign hero_sizes = '(min-width: 480px) 320px, calc(100vw - 30px)' %}
{% endcase %}

{% assign category_projects = site.projects | where: 'category', page.category | sort: 'importance' %}
{% assign previous_project = null %}
{% assign next_project = null %}
{% assign previous_candidate = null %}
{% assign current_project_found = false %}
{% for sibling in category_projects %}
  {% if current_project_found %}
    {% assign next_project = sibling %}
    {% break %}
  {% elsif sibling.url == page.url %}
    {% assign previous_project = previous_candidate %}
    {% assign current_project_found = true %}
  {% else %}
    {% assign previous_candidate = sibling %}
  {% endif %}
{% endfor %}

<div class="post project-case">
  <header class="post-header project-case__header">
    <div class="project-case__eyebrow">
      <a href="{{ '/projects/' | append: '#' | append: page.category | relative_url }}">
        <span class="lang-en-only">{{ category_en }}</span><span class="lang-zh-only">{{ category_zh }}</span>
      </a>
      {% if status_en != blank %}
        <span class="project-case__eyebrow-separator" aria-hidden="true">/</span>
        <span class="project-case__status project-case__status--{{ page.project_status }}">
          <span class="project-case__status-dot" aria-hidden="true"></span>
          <span class="lang-en-only">{{ status_en }}</span><span class="lang-zh-only">{{ status_zh }}</span>
        </span>
      {% endif %}
    </div>
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article class="project-case__article project-detail">
    <div
      class="project-case__hero project-case__hero--{{ hero_fit }}{{ hero_width_class }}{% if page.hero_ratio == 'wide' %} project-case__hero--wide{% endif %}"
      style="--project-hero-position: {{ hero_pos }}; --project-hero-scale: {{ page.hero_zoom | default: 1 }};"
    >
      {%
        include figure.liquid
        path=hero_path
        class="project-case__hero-image"
        zoomable=true
        loading="eager"
        fetchpriority="high"
        sizes=hero_sizes
        alt=hero_alt
      %}
    </div>

    <span id="project-overview-label" class="sr-only">
      <span class="lang-en-only">Project overview</span><span class="lang-zh-only">项目概览</span>
    </span>
    <dl class="project-case__facts" aria-labelledby="project-overview-label">
      <div class="project-case__fact">
        <dt><span class="lang-en-only">Role</span><span class="lang-zh-only">角色</span></dt>
        <dd>
          <span class="lang-en-only">{{ page.project_role.en }}</span><span class="lang-zh-only">{{ page.project_role.zh }}</span>
        </dd>
      </div>
      <div class="project-case__fact">
        <dt><span class="lang-en-only">Timeline</span><span class="lang-zh-only">时间</span></dt>
        <dd>{{ page.timeframe }}</dd>
      </div>
      <div class="project-case__fact project-case__fact--focus">
        <dt><span class="lang-en-only">Focus</span><span class="lang-zh-only">技术重点</span></dt>
        <dd>
          <span class="lang-en-only">{{ page.project_focus.en }}</span><span class="lang-zh-only">{{ page.project_focus.zh }}</span>
        </dd>
      </div>
    </dl>

    {% if page.project_toc and page.project_toc.size > 1 %}
      <nav class="project-case__toc" aria-labelledby="project-toc-label">
        <span id="project-toc-label" class="project-case__toc-title">
          <span class="lang-en-only">On this page</span><span class="lang-zh-only">本页目录</span>
        </span>
        <ol class="project-case__toc-list">
          {% for item in page.project_toc %}
            <li>
              <a href="#{{ item.id | escape }}">
                <span class="lang-en-only">{{ item.en }}</span><span class="lang-zh-only">{{ item.zh }}</span>
              </a>
            </li>
          {% endfor %}
        </ol>
      </nav>
    {% endif %}

    <h2 id="project-details" class="project-case__details-title">
      <span class="lang-en-only">Project Details</span><span class="lang-zh-only">项目详情</span>
    </h2>

    {{ content }}

    <nav
      class="project-case__footer-nav{% unless previous_project %} project-case__footer-nav--no-previous{% endunless %}{% unless next_project %} project-case__footer-nav--no-next{% endunless %}"
      aria-labelledby="project-navigation-label"
    >
      <span id="project-navigation-label" class="sr-only">
        <span class="lang-en-only">Project navigation</span><span class="lang-zh-only">项目导航</span>
      </span>

      {% if previous_project %}
        <a
          class="project-case__footer-segment project-case__footer-segment--previous"
          href="{% if previous_project.redirect %}{{ previous_project.redirect }}{% else %}{{ previous_project.url | relative_url }}{% endif %}"
        >
          <span class="project-case__footer-direction">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span class="lang-en-only">Previous project</span><span class="lang-zh-only">上一个项目</span>
          </span>
          <span class="project-case__footer-title">{{ previous_project.title }}</span>
        </a>
      {% else %}
        <span
          class="project-case__footer-segment project-case__footer-segment--previous project-case__footer-segment--empty"
          aria-hidden="true"
        ></span>
      {% endif %}

      <a
        class="project-case__footer-segment project-case__footer-segment--index"
        href="{{ '/projects/' | append: '#' | append: page.category | relative_url }}"
      >
        <span class="project-case__footer-direction">
          <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
          <span class="lang-en-only">Project index</span><span class="lang-zh-only">项目索引</span>
        </span>
        <span class="project-case__footer-title">
          <span class="lang-en-only">{{ category_en }}</span><span class="lang-zh-only">{{ category_zh }}</span>
        </span>
      </a>

      {% if next_project %}
        <a
          class="project-case__footer-segment project-case__footer-segment--next"
          href="{% if next_project.redirect %}{{ next_project.redirect }}{% else %}{{ next_project.url | relative_url }}{% endif %}"
        >
          <span class="project-case__footer-direction">
            <span class="lang-en-only">Next project</span><span class="lang-zh-only">下一个项目</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </span>
          <span class="project-case__footer-title">{{ next_project.title }}</span>
        </a>
      {% else %}
        <span
          class="project-case__footer-segment project-case__footer-segment--next project-case__footer-segment--empty"
          aria-hidden="true"
        ></span>
      {% endif %}
    </nav>
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
