{% capture footer_contents %}
  {%- comment -%}
    Footer text intentionally left blank — the copyright / "Powered by"
    credit line was removed by request. Impressum and last-updated are
    still honored if their site settings are set.
  {%- endcomment -%}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% comment %} Only render the footer bar when there is something to show. {% endcomment %}
{% assign footer_stripped = footer_contents | strip_html | strip %}
{% if footer_stripped != '' %}
  {% if site.footer_fixed %}
    <footer class="fixed-bottom" role="contentinfo">
      <div class="container mt-0">
        {{ footer_contents }}
      </div>
    </footer>
  {% else %}
    <footer class="sticky-bottom mt-5" role="contentinfo">
      {% if site.newsletter.enabled %}
        {% include newsletter.liquid %}
      {% endif %}

      <div class="container">
        {{ footer_contents }}
      </div>
    </footer>
  {% endif %}
{% endif %}
